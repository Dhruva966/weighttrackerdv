# Browser-safe Supabase credentials (required for cloud sync in the app)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Scripts only — never expose to Vite or the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: Groq free-tier key for tougher natural-language set parsing (fallback after on-device parser)
VITE_GROQ_API_KEY=your-groq-api-key
