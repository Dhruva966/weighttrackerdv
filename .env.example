# Copy FROM Supabase → Project Settings → API (browser-safe)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Scripts / CLI only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PROJECT_REF=your-project-ref

# Push TO Supabase Edge Function secrets (Dashboard → Edge Functions → Secrets, or `pnpm supabase:secrets`)
GROQ_API_KEY=your-groq-api-key

# Optional local-only fallback if Supabase function is not deployed yet
VITE_GROQ_API_KEY=your-groq-api-key
