# Copy FROM Supabase → Project Settings → API (browser-safe)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Scripts / CLI only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PROJECT_REF=your-project-ref

# Push TO Supabase Edge Function secrets (Dashboard → Edge Functions → Secrets, or `pnpm supabase:secrets`)
# Preferred: Anthropic Claude for messy NL set logs (server-side only — do not put in VITE_*)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional fallback if Anthropic is unset
GROQ_API_KEY=your-groq-api-key

# Optional local-only browser Groq fallback if the Supabase function is not deployed yet
VITE_GROQ_API_KEY=your-groq-api-key

# Lift remote MCP (Claude custom connector) — server-side only
# Generate with: openssl rand -hex 32
LIFT_MCP_TOKEN=your-long-random-token
# Set true to allow Claude log_sets and log_weight (resolve_exercise / list_recent_weigh_ins stay read-only either way)
LIFT_MCP_WRITES_ENABLED=true
# Optional E2E override: LIFT_MCP_URL=https://YOUR_REF.supabase.co/functions/v1/lift-mcp
# Optional: LIFT_MCP_E2E_WRITE=1 to insert a warmup set and weigh-in during pnpm test:lift-mcp
